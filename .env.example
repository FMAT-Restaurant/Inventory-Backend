# Valores de ejemplo para desarrollo local.
MONGO_INITDB_ROOT_USERNAME=inventory
MONGO_INITDB_ROOT_PASSWORD=inventory_dev
MONGO_INITDB_DATABASE=inventory

# NestJS ejecutado en tu computadora. Si cambias las credenciales,
# actualiza tambien esta URL. Dentro de Compose, el host sera db.
MONGODB_URI=mongodb://inventory:inventory_dev@localhost:27017/inventory?authSource=admin
PORT=3000

# Puerto del host donde se publica la app cuando corre en Docker.
# Solo aplica al ambiente de desarrollo: en produccion el servicio se
# accede unicamente a traves del API Gateway.
APP_HOST_PORT=8083

# URL del frontend permitida por CORS. Puedes separar varias con comas.
FRONTEND_URL=http://localhost:5173

# Entorno de ejecucion. El endpoint de reset solo funciona en dev o qa.
# Valores admitidos: development (dev), qa, production (prod).
NODE_ENV=development

# URL de conexion a RabbitMQ (CloudAMQP o local)
RABBITMQ_URL=amqp://admin:supersecurepassword@host.docker.internal:5672
