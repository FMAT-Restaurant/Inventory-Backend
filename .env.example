# Valores de ejemplo para desarrollo local.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory_dev
POSTGRES_DB=inventory

# NestJS ejecutado en tu computadora. Si cambias las credenciales,
# actualiza tambien esta URL. Dentro de Compose, el host sera db.
DATABASE_URL=postgresql://inventory:inventory_dev@localhost:5432/inventory?schema=public
PORT=3000
