# Valores de ejemplo para desarrollo local.
MONGO_INITDB_ROOT_USERNAME=inventory
MONGO_INITDB_ROOT_PASSWORD=inventory_dev
MONGO_INITDB_DATABASE=inventory

# NestJS ejecutado en tu computadora. Si cambias las credenciales,
# actualiza tambien esta URL. Dentro de Compose, el host sera db.
MONGODB_URI=mongodb://inventory:inventory_dev@localhost:27017/inventory?authSource=admin
PORT=3000

# Puerto del host donde se publica la app cuando corre en Docker.
# Solo aplica al ambiente de desarrollo: en produccion el servicio se
# accede unicamente a traves del API Gateway.
APP_HOST_PORT=8083

# URL del frontend permitida por CORS. Puedes separar varias con comas.
FRONTEND_URL=http://localhost:5173

# Entorno de ejecucion.
# Valores admitidos: development (dev), qa, production (prod).
NODE_ENV=development

# URL de conexion a RabbitMQ (CloudAMQP o local)
RABBITMQ_URL=amqp://admin:supersecurepassword@host.docker.internal:5672

# RabbitMQ local para las pruebas de carga (compose.loadtest.yaml)
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=supersecurepassword
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Pruebas de carga k6 (ver tests/k6/README.md)
K6_BASE_URL=http://localhost:8083
K6_RABBITMQ_URL=amqp://admin:supersecurepassword@localhost:5672
K6_AUTH_TOKEN=
K6_POLL_TIMEOUT_MS=10000
K6_POLL_INTERVAL_MS=250
K6_HTTP_P95_MS=500
K6_HTTP_P99_MS=1000
K6_MAX_ERROR_RATE=0.01
K6_EVENT_P95_MS=2000

# Lotes: intervalo del barrido que marca lotes vencidos (0 lo desactiva)
BATCH_EXPIRY_SWEEP_INTERVAL_MS=60000

# Reservas de stock
RESERVATION_TTL_MINUTES=30
RESERVATION_SWEEP_INTERVAL_MS=60000
RESERVATION_CACHE_TTL_MS=30000
RESERVATION_CACHE_ENABLED=true

# Autenticación vía API Gateway (Kong).
# Kong valida el access token HS256 del cliente y propaga la identidad en
# los headers X-User-Id, X-Staff-Id, X-User-Roles y X-User-Permissions.
# El servicio verifica además la firma del token con este secreto compartido.
# En desarrollo local no hay gateway: AUTH_ENABLED=false evita exigir token
# (cualquier otro valor, incluido dejarlo sin definir, la habilita).
AUTH_ENABLED=false
AUTH_JWT_SECRET=cambia-este-secreto-compartido-con-el-gateway
# Emisor esperado del token (claim iss). Opcional: vacío desactiva la validación.
AUTH_JWT_ISSUER=
